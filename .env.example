# Jev / TypeSafe
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
JEV_INPUT_USD_PER_MILLION=0.042

# Executors (only needed for live execution)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
CODEX_MODEL=
FRONTIER_MODEL=

# Runtime
SWITCHBOARD_MODE=balanced
SWITCHBOARD_MAX_COST_USD=1.00
SWITCHBOARD_TELEMETRY_PATH=telemetry/events.jsonl

# Optional context-planning budgets (planning limits, not provider context-window claims)
SWITCHBOARD_CONTEXT_BUDGET_ECONOMY=8000
SWITCHBOARD_CONTEXT_BUDGET_BALANCED=24000
SWITCHBOARD_CONTEXT_BUDGET_PREMIUM=48000
SWITCHBOARD_CONTEXT_BUDGET_MAX=96000
